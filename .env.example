# Copy to .env and replace every example value. Never commit .env.
DATABASE_URL="postgresql://postgres:password@localhost:5432/svu_legal?schema=public"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:4000"
API_PORT=4000
NODE_ENV="development"

# Initial administrator: configure server-side only, then remove ADMIN_INITIAL_PASSWORD after first bootstrap.
ADMIN_INITIAL_NAME="SVU Administrator"
ADMIN_INITIAL_EMAIL="admin@example.com"
ADMIN_INITIAL_PASSWORD="CHANGE-THIS-TO-A-RANDOM-16-CHARACTER-MINIMUM-PASSWORD"

# Private document storage (never place this folder inside apps/web/public)
PRIVATE_UPLOAD_DIR="./.private-uploads"
# Set TRUST_PROXY=true only when the API is behind a correctly configured trusted reverse proxy.
TRUST_PROXY=false

# Razorpay: begin with test keys. Live mode requires account approval and a security review.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
PAYMENTS_ENABLED="false"

# SMTP / transactional email. If absent in development, verification/reset links are logged locally.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="SVU Developers <no-reply@example.com>"

# Production document safety: ClamAV must be available when this is true; production fails closed by default.
MALWARE_SCAN_REQUIRED="false"
CLAMSCAN_PATH="clamscan"
SESSION_COOKIE_SAMESITE="lax"
