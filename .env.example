# Copy this file to .env for local development. Never commit .env or place secrets in NEXT_PUBLIC_* values.

# Required: local example below. For managed production PostgreSQL, use the provider connection string (often with sslmode=require). Supabase PostgreSQL is supported.
DATABASE_URL="postgresql://postgres:password@localhost:5432/svu_legal?schema=public"

# Single-origin deployment. Keep NEXT_PUBLIC_API_URL empty; the API is served by this same Next.js app.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL=""
NODE_ENV="development"

# Initial administrator bootstrap. Use a unique password of at least 16 characters.
ADMIN_INITIAL_NAME="SVU Administrator"
ADMIN_INITIAL_EMAIL="admin@example.com"
ADMIN_INITIAL_PASSWORD="CHANGE-THIS-TO-A-RANDOM-16-CHARACTER-MINIMUM-PASSWORD"

# Razorpay: use test credentials first. Leave blank and payments disabled until configured.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
PAYMENTS_ENABLED="false"

# SMTP / transactional email. Without these values, local development may show verification links in the API response.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="SVU Developers <no-reply@your-domain.example>"

# Local private file storage. Vercel serverless disk is ephemeral; configure durable private object storage before production document uploads.
PRIVATE_UPLOAD_DIR="./.private-uploads"
TRUST_PROXY="false"
MALWARE_SCAN_REQUIRED="false"
CLAMSCAN_PATH="clamscan"
SESSION_COOKIE_SAMESITE="lax"
